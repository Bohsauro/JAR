# JAR (Just Another Router) — copy to .env and fill in
# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Password for the dashboard / management API (/api). REQUIRED for remote access;
# without it /api answers only to localhost. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
PENNY_ADMIN_TOKEN=
# Max /v1 requests per minute per client IP (0 = unlimited). Default 120.
# PENNY_RATE_LIMIT=120
# Webhook called when the route changes (Slack, Discord, or Telegram sendMessage?chat_id=...).
# PENNY_WEBHOOK_URL=
